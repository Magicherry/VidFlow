<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VidFlow.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:VidFlow.Localization"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="{StaticResource PagePaddingNarrow}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!--  See HomePage: keep MaxWidth off the ScrollViewer's direct child.  -->
        <Grid>
            <StackPanel
                x:Name="ContentPanel"
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="4">
                <!--  The title on the list of categories; "Settings > Downloads" on one of them (as in Windows Settings).  -->
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,0,0,4"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind l:L.Get('Nav_Settings')}" />
                <BreadcrumbBar
                    x:Name="Breadcrumb"
                    Margin="0,0,0,4"
                    ItemClicked="Breadcrumb_ItemClicked"
                    Visibility="Collapsed">
                    <BreadcrumbBar.Resources>
                        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                        <x:Double x:Key="BreadcrumbBarChevronFontSize">14</x:Double>
                        <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                        <Thickness x:Key="BreadcrumbBarChevronPadding">11,6,12,0</Thickness>
                    </BreadcrumbBar.Resources>
                </BreadcrumbBar>

                <!--  The categories, each a page of its own (Tag: the page's name after "settings/")  -->
                <StackPanel x:Name="CategoryPanel" Spacing="4">
                    <tk:SettingsCard
                        Click="Category_Click"
                        Description="{x:Bind l:L.Get('Settings_GeneralDescription')}"
                        Header="{x:Bind l:L.Get('Settings_General')}"
                        IsClickEnabled="True"
                        Tag="general">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE713;" />
                        </tk:SettingsCard.HeaderIcon>
                    </tk:SettingsCard>
                    <tk:SettingsCard
                        Click="Category_Click"
                        Description="{x:Bind l:L.Get('Settings_DownloadsDescription')}"
                        Header="{x:Bind l:L.Get('Settings_Downloads')}"
                        IsClickEnabled="True"
                        Tag="downloads">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE896;" />
                        </tk:SettingsCard.HeaderIcon>
                    </tk:SettingsCard>
                    <tk:SettingsCard
                        Click="Category_Click"
                        Description="{x:Bind l:L.Get('Settings_MediaDescription')}"
                        Header="{x:Bind l:L.Get('Settings_Media')}"
                        IsClickEnabled="True"
                        Tag="media">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE714;" />
                        </tk:SettingsCard.HeaderIcon>
                    </tk:SettingsCard>
                    <tk:SettingsCard
                        Click="Category_Click"
                        Description="{x:Bind l:L.Get('Settings_AddOnsDescription')}"
                        Header="{x:Bind l:L.Get('Settings_AddOns')}"
                        IsClickEnabled="True"
                        Tag="addons">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xECAA;" />
                        </tk:SettingsCard.HeaderIcon>
                    </tk:SettingsCard>
                    <tk:SettingsCard
                        x:Name="AboutCard"
                        Click="AboutCard_Click"
                        Header="{x:Bind l:L.Get('Settings_AboutUpdates')}"
                        IsClickEnabled="True">
                        <tk:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                        </tk:SettingsCard.HeaderIcon>
                        <InfoBadge
                            x:Name="AboutBadge"
                            Style="{StaticResource AttentionIconInfoBadgeStyle}"
                            Visibility="Collapsed" />
                    </tk:SettingsCard>
                </StackPanel>

                <!--  General: how the app looks, what it does in the background, what it tells you  -->
                <StackPanel
                    x:Name="GeneralPanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <TextBlock Margin="1,8,0,4" Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_Appearance')}" />
                    <tk:SettingsCard Header="{x:Bind l:L.Get('Settings_Language')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF2B7;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="LanguageCombo"
                            MinWidth="200"
                            SelectionChanged="LanguageCombo_SelectionChanged" />
                    </tk:SettingsCard>
                    <InfoBar
                        x:Name="RestartBar"
                        Title="{x:Bind l:L.Get('Settings_RestartTitle')}"
                        Message="{x:Bind l:L.Get('Settings_RestartMessage')}"
                        Severity="Informational"
                        Visibility="{x:Bind RestartBar.IsOpen, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Click="Restart_Click" Content="{x:Bind l:L.Get('Settings_RestartNow')}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <tk:SettingsCard Header="{x:Bind l:L.Get('Settings_Theme')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="ThemeCombo"
                            MinWidth="200"
                            SelectionChanged="ThemeCombo_SelectionChanged" />
                    </tk:SettingsCard>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_GroupBehavior')}" />
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_TrayDescription')}" Header="{x:Bind l:L.Get('Settings_Tray')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE737;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="TrayToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_ClipboardDescription')}" Header="{x:Bind l:L.Get('Settings_Clipboard')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77F;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="ClipboardToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_GroupNotifications')}" />
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_NotifyDescription')}" Header="{x:Bind l:L.Get('Settings_Notify')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEA8F;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="NotifyToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_NotifyFailureDescription')}" Header="{x:Bind l:L.Get('Settings_NotifyFailure')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7BA;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="NotifyFailureToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                </StackPanel>

                <!--  Downloads: where they go, how fast, and through which connection  -->
                <StackPanel
                    x:Name="DownloadsPanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <TextBlock Margin="1,8,0,4" Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_GroupSaving')}" />
                    <tk:SettingsCard
                        x:Name="FolderCard"
                        Click="ChangeFolder_Click"
                        Header="{x:Bind l:L.Get('Settings_Folder')}"
                        IsClickEnabled="True">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </tk:SettingsCard.HeaderIcon>
                        <tk:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE70F;" />
                        </tk:SettingsCard.ActionIcon>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{x:Bind l:L.Get('Settings_Concurrency')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9F5;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="ConcurrencyCombo"
                            MinWidth="200"
                            SelectionChanged="ConcurrencyCombo_SelectionChanged" />
                    </tk:SettingsCard>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_GroupSpeed')}" />
                    <tk:SettingsCard x:Name="MultiConnectionCard" Header="{x:Bind l:L.Get('Settings_MultiConnection')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xEC4A;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="MultiConnectionToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                    <!--  Speed limit: a switch, and the value (with its unit) once it is on  -->
                    <tk:SettingsExpander
                        x:Name="SpeedExpander"
                        Header="{x:Bind l:L.Get('Settings_SpeedLimit')}">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEC48;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}"
                            x:Name="SpeedToggle"
                            AutomationProperties.Name="{x:Bind l:L.Get('Settings_SpeedLimit')}"
                            Toggled="SpeedToggle_Toggled" />
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard x:Name="SpeedValueCard" Header="{x:Bind l:L.Get('Settings_SpeedMax')}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox
                                        x:Name="SpeedBox"
                                        Width="176"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind l:L.Get('Settings_SpeedMax')}"
                                        Minimum="0.1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="SpeedBox_ValueChanged" />
                                    <ComboBox
                                        x:Name="SpeedUnitCombo"
                                        Width="96"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind l:L.Get('Settings_SpeedUnit')}"
                                        SelectionChanged="SpeedUnitCombo_SelectionChanged">
                                        <ComboBoxItem Content="KB/s" Tag="KB" />
                                        <ComboBoxItem Content="MB/s" Tag="MB" />
                                    </ComboBox>
                                </StackPanel>
                            </tk:SettingsCard>
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_GroupNetwork')}" />
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_ProxyDescription')}" Header="{x:Bind l:L.Get('Settings_Proxy')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </tk:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="ProxyBox"
                            MinWidth="240"
                            AutomationProperties.Name="{x:Bind l:L.Get('Settings_Proxy')}"
                            LostFocus="ProxyBox_LostFocus"
                            PlaceholderText="{x:Bind l:L.Get('Settings_ProxyPlaceholder')}" />
                    </tk:SettingsCard>
                    <!--  Can YouTube be reached with the proxy above (or the system proxy)?  -->
                    <tk:SettingsCard x:Name="ConnectivityCard" Header="{x:Bind l:L.Get('Settings_Connectivity')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon x:Name="ConnectivityIcon" Glyph="&#xE9D9;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing
                                x:Name="ConnectivityRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="ConnectivityButton"
                                MinWidth="96"
                                Click="TestConnectivity_Click"
                                Content="{x:Bind l:L.Get('Settings_ConnectivityTest')}" />
                        </StackPanel>
                    </tk:SettingsCard>
                </StackPanel>

                <!--  Video and subtitles: what goes into each file saved  -->
                <StackPanel
                    x:Name="MediaPanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <TextBlock Margin="1,8,0,4" Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_GroupVideo')}" />
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_H264Description')}" Header="{x:Bind l:L.Get('Settings_H264')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="H264Toggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_MetadataDescription')}" Header="{x:Bind l:L.Get('Settings_Metadata')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="MetadataToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_ChaptersDescription')}" Header="{x:Bind l:L.Get('Settings_Chapters')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8A4;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="ChaptersToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_SponsorBlockDescription')}" Header="{x:Bind l:L.Get('Settings_SponsorBlock')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE893;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox
                            x:Name="SponsorBlockCombo"
                            MinWidth="200"
                            SelectionChanged="SponsorBlockCombo_SelectionChanged" />
                    </tk:SettingsCard>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_SubtitlesSection')}" />
                    <!--  Languages: tick common ones; other codes for anything not listed. The description sums up the choice.  -->
                    <tk:SettingsCard
                        x:Name="SubLangsCard"
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical"
                        Header="{x:Bind l:L.Get('Settings_SubLangs')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xED1E;" />
                        </tk:SettingsCard.HeaderIcon>
                        <!--  One check box per common language, filled in code; wraps on narrow windows.  -->
                        <VariableSizedWrapGrid
                            x:Name="SubLangsPanel"
                            Margin="0,4,0,0"
                            ItemWidth="132"
                            Orientation="Horizontal" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_SubLangsOtherDescription')}" Header="{x:Bind l:L.Get('Settings_SubLangsOther')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE943;" />
                        </tk:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="SubLangsOtherBox"
                            MinWidth="200"
                            AutomationProperties.Name="{x:Bind l:L.Get('Settings_SubLangsOther')}"
                            LostFocus="SubLangsOtherBox_LostFocus"
                            PlaceholderText="fr, de, es" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_DanmakuDescription')}" Header="{x:Bind l:L.Get('Settings_Danmaku')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch OnContent="{x:Bind l:L.Get('Common_On')}" OffContent="{x:Bind l:L.Get('Common_Off')}" x:Name="DanmakuToggle" Toggled="Toggle_Changed" />
                    </tk:SettingsCard>
                </StackPanel>

                <!--  Add-ons: optional features that need a download of their own (hundreds of MB), with what each takes up on disk. The components every download needs are on About & updates.  -->
                <StackPanel
                    x:Name="AddOnsPanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <!--  Speech recognition: the program and one model; the header says where it stands and has the one
                          thing to do. See SpeechRecognizer.  -->
                    <tk:SettingsExpander x:Name="SpeechCard" Header="{x:Bind l:L.Get('Settings_Speech')}">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE720;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressBar
                                x:Name="SpeechProgress"
                                Width="120"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="SpeechButton"
                                MinWidth="96"
                                Click="SpeechButton_Click" />
                        </StackPanel>
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_SpeechModelDescription')}" Header="{x:Bind l:L.Get('Settings_SpeechModel')}">
                                <ComboBox
                                    x:Name="SpeechModelCombo"
                                    MinWidth="200"
                                    AutomationProperties.Name="{x:Bind l:L.Get('Settings_SpeechModel')}"
                                    SelectionChanged="SpeechModelCombo_SelectionChanged" />
                            </tk:SettingsCard>
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>
                    <!--  The CUDA build for speech recognition: offered with an NVIDIA card, once recognition is there  -->
                    <tk:SettingsCard x:Name="SpeechGpuCard" Header="{x:Bind l:L.Get('Settings_SpeechGpu')}">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE950;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressBar
                                x:Name="SpeechGpuProgress"
                                Width="120"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="SpeechGpuButton"
                                MinWidth="96"
                                Click="SpeechGpuButton_Click" />
                        </StackPanel>
                    </tk:SettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
