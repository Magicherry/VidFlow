<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VidFlow.Pages.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:VidFlow.Localization"
    xmlns:m="using:VidFlow.Models"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <!--  Files dropped anywhere on the page are added (the window itself takes dropped links).  -->
    <Grid
        x:Name="RootPanel"
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="36,24,36,0"
        AllowDrop="True"
        Background="Transparent"
        DragOver="Page_DragOver"
        Drop="Page_Drop"
        RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootPanel.Padding" Value="16,16,16,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title, with adding files on the right  -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind l:L.Get('Nav_Convert')}" />
            <Button
                Grid.Column="1"
                Height="32"
                VerticalAlignment="Center"
                Click="AddFiles_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind l:L.Get('Convert_AddFiles')}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Width="40"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind l:L.Get('Downloads_More')}"
                ToolTipService.ToolTip="{x:Bind l:L.Get('Downloads_More')}">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Click="ClearFinished_Click" Text="{x:Bind l:L.Get('Convert_ClearFinished')}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE894;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <InfoBar
            x:Name="FfmpegBar"
            Grid.Row="1"
            Title="{x:Bind l:L.Get('Error_ConvertNeedsFfmpeg')}"
            IsClosable="False"
            Severity="Warning"
            Visibility="{x:Bind FfmpegBar.IsOpen, Mode=OneWay}" />

        <!--  Where converted files go: next to each source, or one chosen folder  -->
        <tk:SettingsCard
            x:Name="FolderCard"
            Grid.Row="2"
            Header="{x:Bind l:L.Get('Convert_Output')}">
            <tk:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8B7;" />
            </tk:SettingsCard.HeaderIcon>
            <ComboBox
                x:Name="FolderCombo"
                MinWidth="200"
                AutomationProperties.Name="{x:Bind l:L.Get('Convert_Output')}"
                SelectionChanged="FolderCombo_SelectionChanged" />
        </tk:SettingsCard>

        <!--  Empty: what can be converted, and how to add it  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="3"
            Margin="0,0,0,80"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8AB;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind l:L.Get('Convert_EmptyTitle')}" />
            <TextBlock
                MaxWidth="420"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind l:L.Get('Convert_EmptyBody')}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            x:Name="FileList"
            Grid.Row="3"
            AutomationProperties.Name="{x:Bind l:L.Get('Nav_Convert')}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:ConvertItem">
                    <Border Padding="12" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="44"
                                Height="44"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Source}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Details}" />
                                <ProgressBar
                                    Margin="0,4,0,0"
                                    ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                    Visibility="{x:Bind IsConverting, Mode=OneWay}"
                                    Value="{x:Bind Progress, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                            <!--  What it becomes: chosen while it waits  -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE72A;" />
                                <ComboBox
                                    MinWidth="150"
                                    AutomationProperties.Name="{x:Bind l:L.Get('Convert_Target')}"
                                    IsEnabled="{x:Bind IsWaiting, Mode=OneWay}"
                                    ItemsSource="{x:Bind Targets}"
                                    SelectedIndex="{x:Bind TargetIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_ShowInFolder')}"
                                    Click="ShowInFolder_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_ShowInFolder')}"
                                    Visibility="{x:Bind IsDone, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_Retry')}"
                                    Click="Retry_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_Retry')}"
                                    Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_CopyError')}"
                                    Click="CopyError_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_CopyError')}"
                                    Visibility="{x:Bind IsFailed, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Common_Cancel')}"
                                    Click="Cancel_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Common_Cancel')}"
                                    Visibility="{x:Bind IsConverting, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_Remove')}"
                                    Click="Remove_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_Remove')}"
                                    Visibility="{x:Bind CanRemove, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE894;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Start: everything waiting, one after another  -->
        <Grid
            x:Name="StartBar"
            Grid.Row="4"
            Padding="0,0,0,24"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="SummaryText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <Button
                x:Name="StartButton"
                Grid.Column="1"
                MinWidth="120"
                Click="Start_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                    <TextBlock Text="{x:Bind l:L.Get('Convert_Start')}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
