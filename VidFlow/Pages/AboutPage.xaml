<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VidFlow.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:VidFlow.Localization"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="{StaticResource PagePaddingNarrow}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!--  See HomePage: keep MaxWidth off the ScrollViewer's direct child.  -->
        <Grid>
            <StackPanel
                x:Name="ContentPanel"
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="4">
                <!--  "Settings > About & updates", sized like a page title (as in Windows Settings).  -->
                <BreadcrumbBar
                    x:Name="Breadcrumb"
                    Margin="0,0,0,4"
                    ItemClicked="Breadcrumb_ItemClicked">
                    <BreadcrumbBar.Resources>
                        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                        <x:Double x:Key="BreadcrumbBarChevronFontSize">14</x:Double>
                        <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                        <Thickness x:Key="BreadcrumbBarChevronPadding">11,6,12,0</Thickness>
                    </BreadcrumbBar.Resources>
                </BreadcrumbBar>

                <!--  App: version, update status and update preference  -->
                <tk:SettingsCard x:Name="UpdateCard" Header="{x:Bind l:L.Get('Settings_Updates')}">
                    <tk:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressBar
                            x:Name="UpdateProgress"
                            Width="120"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="UpdateButton"
                            MinWidth="120"
                            Click="UpdateButton_Click" />
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_UpdateModeDescription')}" Header="{x:Bind l:L.Get('Settings_UpdateMode')}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE823;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="UpdateModeCombo"
                        MinWidth="200"
                        SelectionChanged="UpdateModeCombo_SelectionChanged" />
                </tk:SettingsCard>
                <tk:SettingsExpander x:Name="ReleaseNotesExpander" Header="{x:Bind l:L.Get('Settings_ReleaseNotes')}">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <TextBlock
                                x:Name="ReleaseNotesText"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!--  Components  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_Components')}" />
                <!--  Collapsed while closed so the StackPanel doesn't add spacing for it.  -->
                <InfoBar
                    x:Name="ToolErrorBar"
                    Closed="ToolErrorBar_Closed"
                    Severity="Error"
                    Visibility="{x:Bind ToolErrorBar.IsOpen, Mode=OneWay}" />
                <!--  The overall state and the buttons in the header; one row per component inside (built in code).  -->
                <tk:SettingsExpander x:Name="ToolsSummaryCard">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon x:Name="ToolsSummaryIcon" Glyph="&#xE895;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="UpdateAllToolsButton"
                            Click="UpdateAllTools_Click"
                            Content="{x:Bind l:L.Get('Tools_UpdateAll')}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="CheckToolsButton"
                            MinWidth="96"
                            Click="CheckTools_Click"
                            Content="{x:Bind l:L.Get('Settings_CheckUpdate')}" />
                    </StackPanel>
                </tk:SettingsExpander>
                <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_AutoUpdateDescription')}" Header="{x:Bind l:L.Get('Settings_AutoUpdate')}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE777;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AutoUpdateToggle" Toggled="AutoUpdateToggle_Toggled" />
                </tk:SettingsCard>

                <!--  About  -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_About')}" />
                <tk:SettingsExpander Description="{x:Bind l:L.Get('About_Description')}" Header="VidFlow">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <TextBlock
                        x:Name="VersionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind l:L.Get('About_Disclaimer')}"
                                TextWrapping="Wrap" />
                        </tk:SettingsCard>
                        <tk:SettingsCard
                            Click="Licenses_Click"
                            Header="{x:Bind l:L.Get('About_Licenses')}"
                            IsClickEnabled="True" />
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <tk:SettingsExpander Description="{x:Bind l:L.Get('About_TroubleshootDescription')}" Header="{x:Bind l:L.Get('About_Troubleshoot')}">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE90F;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard
                            Click="OpenLogs_Click"
                            Header="{x:Bind l:L.Get('About_OpenLogs')}"
                            IsClickEnabled="True">
                            <tk:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </tk:SettingsCard.ActionIcon>
                        </tk:SettingsCard>
                        <tk:SettingsCard
                            Click="OpenDataFolder_Click"
                            Header="{x:Bind l:L.Get('About_OpenData')}"
                            IsClickEnabled="True">
                            <tk:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </tk:SettingsCard.ActionIcon>
                        </tk:SettingsCard>
                        <tk:SettingsCard
                            Click="RunWizard_Click"
                            Header="{x:Bind l:L.Get('About_RunWizard')}"
                            IsClickEnabled="True" />
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
