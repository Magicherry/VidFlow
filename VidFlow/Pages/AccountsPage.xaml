<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VidFlow.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:VidFlow.Localization"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="{StaticResource PagePaddingNarrow}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!--  See HomePage: keep MaxWidth off the ScrollViewer's direct child.  -->
        <Grid>
            <StackPanel
                x:Name="ContentPanel"
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind l:L.Get('Settings_Accounts')}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource PageDescriptionStyle}"
                    Text="{x:Bind l:L.Get('Accounts_Description')}" />

                <!--  Collapsed while closed so the StackPanel doesn't add spacing for it.  -->
                <InfoBar
                    x:Name="ErrorBar"
                    Margin="0,12,0,0"
                    Severity="Error"
                    Visibility="{x:Bind ErrorBar.IsOpen, Mode=OneWay}" />

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Accounts_Platforms')}" />
                <tk:SettingsCard x:Name="BiliAccountCard" Header="{x:Bind l:L.Get('Platform_Bilibili')}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="BiliAccountButton"
                        MinWidth="96"
                        Click="BiliAccount_Click" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="YouTubeAccountCard" Header="YouTube">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="YouTubeAccountButton"
                        MinWidth="96"
                        Click="YouTubeAccount_Click" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="DouyinAccountCard" Header="{x:Bind l:L.Get('Platform_Douyin')}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="DouyinAccountButton"
                        MinWidth="96"
                        Click="DouyinAccount_Click" />
                </tk:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind l:L.Get('Settings_OtherCookies')}" />
                <TextBlock
                    Margin="1,0,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind l:L.Get('Settings_OtherCookiesDescription')}"
                    TextWrapping="Wrap" />
                <tk:SettingsCard Description="{x:Bind l:L.Get('Settings_BrowserCookiesDescription')}" Header="{x:Bind l:L.Get('Settings_BrowserCookies')}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </tk:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="BrowserCombo"
                        MinWidth="160"
                        SelectionChanged="BrowserCombo_SelectionChanged" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="CookieFileCard" Header="{x:Bind l:L.Get('Settings_CookieFile')}">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ClearCookieFileButton"
                            Click="ClearCookieFile_Click"
                            Content="{x:Bind l:L.Get('Common_Clear')}" />
                        <Button Click="PickCookieFile_Click" Content="{x:Bind l:L.Get('Settings_ChooseFile')}" />
                    </StackPanel>
                </tk:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
