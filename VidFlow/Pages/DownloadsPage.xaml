<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VidFlow.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:VidFlow.Localization"
    xmlns:m="using:VidFlow.Models"
    NavigationCacheMode="Required">

    <Grid
        x:Name="RootPanel"
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="36,24,36,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootPanel.Padding" Value="16,16,16,0" />
                        <Setter Target="OpenFolderLabel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind l:L.Get('Downloads_Title')}" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="{x:Bind l:L.Get('Downloads_OpenFolder')}"
                Click="OpenDownloadFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                    <TextBlock x:Name="OpenFolderLabel" Text="{x:Bind l:L.Get('Downloads_OpenFolder')}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="{x:Bind l:L.Get('Downloads_More')}"
                ToolTipService.ToolTip="{x:Bind l:L.Get('Downloads_More')}">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Click="PauseAll_Click" Text="{x:Bind l:L.Get('Downloads_PauseAll')}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE769;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="ResumeAll_Click" Text="{x:Bind l:L.Get('Downloads_ResumeAll')}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="ClearFinished_Click" Text="{x:Bind l:L.Get('Downloads_ClearFinished')}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE894;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Empty state  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            Margin="0,0,0,80"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind l:L.Get('Downloads_EmptyTitle')}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind l:L.Get('Downloads_EmptyBody')}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            x:Name="DownloadList"
            Grid.Row="1"
            Padding="0,0,0,24"
            AutomationProperties.Name="{x:Bind l:L.Get('Downloads_Title')}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:DownloadItem">
                    <Border
                        Padding="12"
                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                        Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <!--  Fixed action column (room for 3 buttons) keeps progress bars the same length in every row  -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Width="128"
                                Height="72"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE714;" />
                                <Image
                                    AutomationProperties.AccessibilityView="Raw"
                                    Source="{x:Bind Thumbnail, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Label}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <ProgressBar
                                    Margin="0,4,0,0"
                                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                    ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                    ShowPaused="{x:Bind IsPausedOrCanceled, Mode=OneWay}"
                                    Visibility="{x:Bind ShowProgress, Mode=OneWay}"
                                    Value="{x:Bind Progress, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_Play')}"
                                    Click="OpenFile_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_Play')}"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_ShowInFolder')}"
                                    Click="ShowInFolder_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_ShowInFolder')}"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_Pause')}"
                                    Click="Pause_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_Pause')}"
                                    Visibility="{x:Bind CanPause, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE769;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_Resume')}"
                                    Click="Resume_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_Resume')}"
                                    Visibility="{x:Bind CanResume, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_Retry')}"
                                    Click="Retry_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_Retry')}"
                                    Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_CopyError')}"
                                    Click="CopyError_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_CopyError')}"
                                    Visibility="{x:Bind IsFailed, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Common_Cancel')}"
                                    Click="Cancel_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Common_Cancel')}"
                                    Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind l:L.Get('Action_Remove')}"
                                    Click="Remove_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind l:L.Get('Action_Remove')}"
                                    Visibility="{x:Bind CanRemove, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
