<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VidFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:VidFlow.Localization"
    Title="VidFlow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="VidFlow"
            Height="48"
            IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <!--  App update state next to the caption buttons: available, downloading, ready to install  -->
            <TitleBar.RightHeader>
                <Button
                    x:Name="TitleUpdateButton"
                    Height="32"
                    Margin="0,0,8,0"
                    Padding="10,0"
                    Click="TitleUpdateButton_Click"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="TitleUpdateIcon" FontSize="14" />
                            <ProgressRing
                                x:Name="TitleUpdateRing"
                                Width="16"
                                Height="16"
                                IsIndeterminate="False"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBlock
                            x:Name="TitleUpdateText"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="0"
            DisplayModeChanged="NavView_DisplayModeChanged"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="240"
            ItemInvoked="NavView_ItemInvoked"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind l:L.Get('Nav_Home')}" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind l:L.Get('Nav_Downloads')}" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ActiveBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind l:L.Get('Nav_Templates')}" Tag="templates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{x:Bind l:L.Get('Nav_Accounts')}" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind l:L.Get('Nav_Settings')}" Tag="settings">
                    <!--  A dot while an app update is waiting  -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="SettingsBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals" />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!--  Drop target hint shown while a link is dragged over the window  -->
        <Border
            x:Name="DropOverlay"
            Grid.RowSpan="2"
            Margin="12"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon FontSize="40" Glyph="&#xE71B;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind l:L.Get('Drop_Hint')}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
