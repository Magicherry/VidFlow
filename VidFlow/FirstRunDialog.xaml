<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="VidFlow.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:VidFlow.Localization"
    CloseButtonClick="Skip_Click"
    CloseButtonText="{x:Bind l:L.Get('Wizard_Skip')}"
    DefaultButton="Primary"
    PrimaryButtonClick="Next_Click"
    PrimaryButtonText="{x:Bind l:L.Get('Wizard_Next')}"
    SecondaryButtonClick="Back_Click"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Width="460" Spacing="16">
        <!--  Step indicator  -->
        <PipsPager
            x:Name="Pips"
            HorizontalAlignment="Center"
            IsHitTestVisible="False"
            NumberOfPages="3" />

        <!--  Step 1: components  -->
        <StackPanel x:Name="Step1" Spacing="12">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind l:L.Get('Wizard_WelcomeTitle')}" />
            <TextBlock Text="{x:Bind l:L.Get('Wizard_WelcomeBody')}" TextWrapping="Wrap" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="YtDlpIcon" FontSize="16" />
                        <TextBlock x:Name="YtDlpStatus" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="FfmpegIcon" FontSize="16" />
                        <TextBlock x:Name="FfmpegStatus" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <ProgressBar x:Name="InstallProgress" Visibility="Collapsed" />
                    <Button
                        x:Name="InstallButton"
                        HorizontalAlignment="Left"
                        Click="Install_Click"
                        Content="{x:Bind l:L.Get('Wizard_InstallAll')}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock
                        x:Name="InstallError"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Step 2: folder  -->
        <StackPanel
            x:Name="Step2"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind l:L.Get('Wizard_FolderTitle')}" />
            <TextBlock Text="{x:Bind l:L.Get('Wizard_FolderBody')}" TextWrapping="Wrap" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FolderText"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        Click="ChangeFolder_Click"
                        Content="{x:Bind l:L.Get('Wizard_Change')}" />
                </Grid>
            </Border>
        </StackPanel>

        <!--  Step 3: accounts  -->
        <StackPanel
            x:Name="Step3"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind l:L.Get('Wizard_AccountsTitle')}" />
            <TextBlock Text="{x:Bind l:L.Get('Wizard_AccountsBody')}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BiliLoginButton" Click="BiliLogin_Click" />
                <Button x:Name="YtLoginButton" Click="YtLogin_Click" />
            </StackPanel>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind l:L.Get('Wizard_AccountsNote')}"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
